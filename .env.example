# Шаблон для git-клона. Скопируйте в .env и подставьте свои значения.
# .env в git не входит. Секреты не коммитьте.
#
# Прод: домен, порты 80/443, сертификат выпускает Caddy.
#   COMPOSE_FILE=docker-compose.yml:threads/docker-compose.threads.yml
#   cp Caddyfile.example Caddyfile
#
# Свой обратный прокси перед стеком (TLS снаружи, Fluxer слушает HTTP):
#   COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml:threads/docker-compose.threads.yml
#   FLUXER_EDGE_BIND=127.0.0.1:8080
#
# Лаборатория по IP с своим сертификатом (как стенд :19080):
#   COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml:docker-compose.lan-tls.yml:threads/docker-compose.threads.yml
#   cp Caddyfile.lan.example Caddyfile
#   сертификаты в certs/lan.crt и certs/lan.key

FLUXER_DOMAIN=chat.example.com
FLUXER_PUBLIC_SCHEME=https
FLUXER_PUBLIC_PORT=443
#FLUXER_PUBLIC_ORIGIN=https://chat.example.com

COMPOSE_PROJECT_NAME=fluxer-threads
COMPOSE_FILE=docker-compose.yml:threads/docker-compose.threads.yml

FLUXER_REGISTRY_OWNER=fluxerapp
FLUXER_REGISTRY=ghcr.io/${FLUXER_REGISTRY_OWNER}
# Тег v1 плавающий. Патч собран под снимок 1c36a59 и образы, с которых сняты
# dist/AppEntrypoint.js, dist/WorkerEntrypoint.js и клиентский чанк.
# Новый v1 без docs/upgrade.md не подключать.
FLUXER_IMAGE_TAG=v1

# Обязательные секреты. Команды генерации — в docs/prod.md.
POSTGRES_PASSWORD=CHANGE_ME
MEILI_MASTER_KEY=CHANGE_ME
FLUXER_S3_ACCESS_KEY=fluxer
FLUXER_S3_SECRET_KEY=CHANGE_ME
FLUXER_SUDO_MODE_SECRET=CHANGE_ME
FLUXER_CONNECTION_INITIATION_SECRET=CHANGE_ME
FLUXER_GATEWAY_RPC_AUTH_TOKEN=CHANGE_ME
FLUXER_ERLANG_COOKIE=CHANGE_ME
FLUXER_MEDIA_PROXY_SECRET_KEY=CHANGE_ME
FLUXER_MEDIA_PROXY_UPLOAD_RELAY_SECRET_BASE64=CHANGE_ME
FLUXER_ADMIN_SECRET_KEY_BASE=CHANGE_ME
FLUXER_ADMIN_OAUTH_CLIENT_SECRET=CHANGE_ME
FLUXER_VAPID_PUBLIC_KEY=CHANGE_ME
FLUXER_VAPID_PRIVATE_KEY=CHANGE_ME
#FLUXER_VAPID_EMAIL=admin@chat.example.com

LIVEKIT_API_KEY=fluxer
LIVEKIT_API_SECRET=CHANGE_ME
#FLUXER_LIVEKIT_URL=wss://chat.example.com/livekit
#FLUXER_LIVEKIT_TCP_PORT=7881
#FLUXER_LIVEKIT_UDP_PORT=7882
#FLUXER_LIVEKIT_USE_EXTERNAL_IP=false
#FLUXER_LIVEKIT_NODE_IP=203.0.113.10

#FLUXER_PASSKEY_RP_ID=chat.example.com
#FLUXER_PASSKEY_RP_NAME=Fluxer
#FLUXER_PASSKEY_ADDITIONAL_ALLOWED_ORIGINS=https://chat.example.com

FLUXER_KLIPY_API_KEY=
FLUXER_EMAIL_ENABLED=false
FLUXER_EMAIL_PROVIDER=none
FLUXER_EMAIL_FROM_EMAIL=noreply@example.com
FLUXER_EMAIL_FROM_NAME=Fluxer
FLUXER_EMAIL_APP_BASE_URL=
FLUXER_EMAIL_SMTP_HOST=
FLUXER_EMAIL_SMTP_PORT=587
FLUXER_EMAIL_SMTP_USERNAME=
FLUXER_EMAIL_SMTP_PASSWORD=
FLUXER_EMAIL_SMTP_SECURE=true
FLUXER_CAPTCHA_ENABLED=false
FLUXER_CAPTCHA_PROVIDER=none
FLUXER_CAPTCHA_HCAPTCHA_SITE_KEY=
FLUXER_CAPTCHA_HCAPTCHA_SECRET_KEY=
FLUXER_CAPTCHA_TURNSTILE_SITE_KEY=
FLUXER_CAPTCHA_TURNSTILE_SECRET_KEY=
FLUXER_DISCOVERY_ENABLED=true

# Лимиты памяти ниже — потолок контейнера, не резерв. Значения по умолчанию в
# docker-compose.yml рассчитаны на хост около 16 ГиБ. На меньшем хосте снизьте
# их здесь. Лабораторный стенд на 5 ГиБ — отдельный набор, в этот шаблон он не входит.
#FLUXER_POSTGRES_MEMORY_LIMIT=5gb
#FLUXER_API_MEMORY_LIMIT=2560mb
#FLUXER_WORKER_MEMORY_LIMIT=2560mb
